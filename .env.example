# Get your keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Required for /api/init-user in dev (Vite server). Secret key – do not commit.
CLERK_SECRET_KEY=sk_test_...

# Supabase (for init-user – uses API host so DNS works when direct DB does not)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Project Settings → API → service_role (secret)
# Optional: direct Postgres (e.g. migrations). init-user uses Supabase client above.
DATABASE_URL=postgresql://...

# Backend API base URL (e.g. http://localhost:3000 when running Next.js). Leave empty to use Vite dev server for /api/init-user.
VITE_API_URL=

# ElevenLabs text-to-speech (optional; used by /api/tts-eleven and Speaking Coach TTS)
ELEVENLABS_API_KEY=sk_...
# Optional: voice ID (default is Rachel). Find IDs in ElevenLabs dashboard.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# YouTube (Google OAuth) – for onboarding “Connect YouTube”
# Create OAuth 2.0 Client ID (Web) in Google Cloud Console, enable YouTube Data API v3.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Redirect URI must match exactly: dev = http://localhost:3000/api/youtube-callback, prod = https://your-domain.com/api/youtube-callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube-callback
# Where to send user after OAuth (default http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
