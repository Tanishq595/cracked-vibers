# Get your keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Required for /api/init-user in dev (Vite server). Secret key – do not commit.
CLERK_SECRET_KEY=sk_test_...

# Supabase (for init-user – uses API host so DNS works when direct DB does not)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Project Settings → API → service_role (secret)
# Optional: direct Postgres (e.g. migrations). init-user uses Supabase client above.
DATABASE_URL=postgresql://...

# Backend API base URL (e.g. http://localhost:3000 when running Next.js). Leave empty to use Vite dev server for /api/init-user.
VITE_API_URL=

# ElevenLabs text-to-speech (optional; used by /api/tts-eleven and Speaking Coach TTS)
ELEVENLABS_API_KEY=sk_...
# Optional: voice ID (default is Rachel). Find IDs in ElevenLabs dashboard.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google OAuth — YouTube (watch history, search, playlists)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube-callback

# Google OAuth — Classroom (recommended: create a second OAuth 2.0 Web client in Google Cloud Console so YouTube and Classroom stay logged in independently)
GOOGLE_CLASSROOM_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLASSROOM_CLIENT_SECRET=GOCSPX-...

# Notion OAuth (public integration — connect user workspaces)
# Create at https://www.notion.so/my-integrations → build a public integration, add OAuth redirect URI (e.g. http://localhost:3000/api/notion-auth/callback)
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...

# Canvas LMS OAuth (Sign in with Canvas — user logs in on Canvas, app gets access to their courses)
# Get Developer Key from your Canvas instance: Admin → Developer Keys → + Developer Key
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_CLIENT_ID=your_developer_key_client_id
CANVAS_CLIENT_SECRET=your_developer_key_client_secret
# Must match the Redirect URI configured on the Canvas Developer Key (e.g. http://localhost:3000/api/canvas/callback)
CANVAS_REDIRECT_URI=http://localhost:3000/api/canvas/callback
# Optional: fallback for server-side only (no user login). Prefer OAuth for multi-user.
# CANVAS_PERSONAL_TOKEN=
